# Copy to dtrack_collector.env, replace the values, then restrict permissions:
# cp dtrack_collector.env.example dtrack_collector.env && chmod 600 dtrack_collector.env
# The file is read by dtrack_collector.sh, including when cron invokes it after reboot.
DTRACK_API_URL=https://dtrack_collector.example.com
DTRACK_API_KEY=replace-with-your-dependency-track-api-key

# Optional: scan only these whitespace-separated image references instead of
# discovering images from running containers. Images do not need to be running.
# DTRACK_IMAGES="nginx:1.27 ghcr.io/example/service:v1.2.3"

# Optional: mark any tag (latest, version, stable, etc.) as latest only when
# its local registry digest matches both its tag and the remote :latest tag.
# Images pinned by digest are skipped.
# Registry lookup results are cached for 24 hours by default.
DTRACK_CHECK_IMAGE_LATEST=false
# DTRACK_LATEST_CACHE_TTL=86400
# DTRACK_LATEST_CACHE_FILE=/var/lib/dtrack_collector/latest-image-digests.cache